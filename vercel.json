{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/login",
      "destination": "/api/page?path=/login"
    },
    {
      "source": "/admin",
      "destination": "/api/page?path=/admin"
    },
    {
      "source": "/service",
      "destination": "/api/page?path=/service"
    },
    {
      "source": "/supervisor",
      "destination": "/api/page?path=/supervisor"
    },
    {
      "source": "/level4",
      "destination": "/api/page?path=/level4"
    },
    {
      "source": "/xd",
      "destination": "/api/page?path=/xd"
    },
    {
      "source": "/video",
      "destination": "/api/page?path=/video"
    },
    {
      "source": "/iron",
      "destination": "/api/page?path=/iron"
    },
    {
      "source": "/sz",
      "destination": "/api/page?path=/sz"
    },
    {
      "source": "/psz",
      "destination": "/api/page?path=/psz"
    },
    {
      "source": "/msb",
      "destination": "/api/page?path=/msb"
    },
    {
      "source": "/meo",
      "destination": "/api/page?path=/meo"
    },
    {
      "source": "/fm",
      "destination": "/api/page?path=/fm"
    },
    {
      "source": "/concierge",
      "destination": "/api/page?path=/concierge"
    },
    {
      "source": "/soft",
      "destination": "/api/page?path=/soft"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
