{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/login",
      "destination": "/api/page?path=/login"
    },
    {
      "source": "/service",
      "destination": "/api/page?path=/service"
    },
    {
      "source": "/supervisor",
      "destination": "/api/page?path=/supervisor"
    },
    {
      "source": "/level4",
      "destination": "/api/page?path=/level4"
    },
    {
      "source": "/xd",
      "destination": "/api/page?path=/xd"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
