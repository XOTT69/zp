{
  "display_information": {
    "name": "Калькулятор ЗП",
    "description": "Одноразові коди входу до калькулятора зарплати",
    "background_color": "#173c39"
  },
  "features": {
    "bot_user": {
      "display_name": "zp-calculator",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/zp",
        "url": "https://zp-kit.vercel.app/api/slack-command",
        "description": "Підключити свій Slack до калькулятора ЗП",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "users:read",
        "users.profile:read",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
