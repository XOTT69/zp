# Server-only secrets. Configure in Vercel; never commit actual values.
AUTH_SECRET=
AUTH_SESSION_VERSION=1
ROLE_CODE_LOGIN_ENABLED=true
OPERATOR_ACCESS_CODE=
SUPERVISOR_ACCESS_CODE=
LEVEL4_ACCESS_CODE=
XD_ACCESS_CODE=
VIDEO_ACCESS_CODE=
IRON_ACCESS_CODE=
ADMIN_ACCESS_CODE=

# Persistent settings and OTP (required for corporate login)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Corporate login is opt-in until the directory and Slack app are connected.
LDAP_SLACK_ENABLED=false
SLACK_BOT_TOKEN=
LDAP_URL=ldaps://directory.example.invalid:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={{login}})(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
LDAP_EMAIL_DOMAINS=example.invalid
# Optional PEM certificate for the corporate CA; certificate verification stays enabled.
LDAP_CA_CERT=

# Alternative to direct LDAPS: authenticated HTTPS directory bridge inside the company.
LDAP_BRIDGE_URL=
LDAP_BRIDGE_TOKEN=
