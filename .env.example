# Server-only secrets. Configure in Vercel; never commit actual values.
AUTH_SECRET=
AUTH_SESSION_VERSION=1
ROLE_CODE_LOGIN_ENABLED=true
OPERATOR_ACCESS_CODE=
SUPERVISOR_ACCESS_CODE=
LEVEL4_ACCESS_CODE=
XD_ACCESS_CODE=
VIDEO_ACCESS_CODE=
IRON_ACCESS_CODE=
ADMIN_ACCESS_CODE=

# Persistent settings and OTP (required for corporate login)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Corporate login is opt-in until the directory and Slack app are connected.
LDAP_SLACK_ENABLED=false
CORPORATE_AUTH_SOURCE=slack-profile
SLACK_BOT_TOKEN=
# Match the protected About me -> LDAP profile field, without email.
SLACK_IDENTITY_MODE=profile
SLACK_TEAM_ID=
SLACK_LDAP_FIELD_ID=
# Only after owner confirms IT controls this field despite is_protected=false:
# exact SLACK_TEAM_ID:SLACK_LDAP_FIELD_ID pair, never a blanket true.
SLACK_LDAP_FIELD_ATTESTATION=
# Optional initial Preview synchronization during build; regular refresh still required.
SLACK_SYNC_ON_BUILD=false
# Optional: these directory settings are used only with CORPORATE_AUTH_SOURCE=directory.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={{login}})(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
# Only used by the optional legacy SLACK_IDENTITY_MODE=email.
LDAP_EMAIL_DOMAINS=
# Optional PEM certificate for the corporate CA; certificate verification stays enabled.
LDAP_CA_CERT=

# Alternative to direct LDAPS: authenticated HTTPS directory bridge inside the company.
LDAP_BRIDGE_URL=
LDAP_BRIDGE_TOKEN=
